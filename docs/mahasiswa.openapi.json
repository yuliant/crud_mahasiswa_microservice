{
    "openapi": "3.1.2",
    "info": {
        "title": "Dokumentasi API Mahasiswa",
        "version": "1.0.0",
        "description": "API CRUD Mahasiswa untuk pembelajaran microservice. Data layanan dimiliki sendiri; komunikasi antar layanan melalui HTTP JSON."
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8002/api"
        }
    ],
    "paths": {
        "/prodi/{id}/usage": {
            "get": {
                "operationId": "mahasiswa.usage",
                "summary": "Periksa penggunaan prodi. Dipanggil Service Prodi sebelum penghapusan dan oleh frontend untuk konfirmasi",
                "tags": [
                    "Mahasiswa"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id_prodi": {
                                                    "type": "integer"
                                                },
                                                "has_mahasiswa": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "id_prodi",
                                                "has_mahasiswa"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/mahasiswa": {
            "get": {
                "operationId": "mahasiswa.index",
                "summary": "Daftar mahasiswa. Sepuluh data per halaman. Nama prodi diambil frontend dari API Prodi",
                "tags": [
                    "Mahasiswa"
                ],
                "responses": {
                    "200": {
                        "description": "Paginated set of `MahasiswaResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/MahasiswaResource"
                                            }
                                        },
                                        "links": {
                                            "type": "object",
                                            "properties": {
                                                "first": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "last": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "prev": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "next": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "first",
                                                "last",
                                                "prev",
                                                "next"
                                            ]
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer",
                                                    "minimum": 1
                                                },
                                                "from": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "minimum": 1
                                                },
                                                "last_page": {
                                                    "type": "integer",
                                                    "minimum": 1
                                                },
                                                "links": {
                                                    "type": "array",
                                                    "description": "Generated paginator links.",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "url": {
                                                                "type": [
                                                                    "string",
                                                                    "null"
                                                                ]
                                                            },
                                                            "label": {
                                                                "type": "string"
                                                            },
                                                            "active": {
                                                                "type": "boolean"
                                                            }
                                                        },
                                                        "required": [
                                                            "url",
                                                            "label",
                                                            "active"
                                                        ]
                                                    }
                                                },
                                                "path": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Base path for paginator generated URLs."
                                                },
                                                "per_page": {
                                                    "type": "integer",
                                                    "description": "Number of items shown per page.",
                                                    "minimum": 0
                                                },
                                                "to": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "description": "Number of the last item in the slice.",
                                                    "minimum": 1
                                                },
                                                "total": {
                                                    "type": "integer",
                                                    "description": "Total number of items being paginated.",
                                                    "minimum": 0
                                                }
                                            },
                                            "required": [
                                                "current_page",
                                                "from",
                                                "last_page",
                                                "links",
                                                "path",
                                                "per_page",
                                                "to",
                                                "total"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "links",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "operationId": "mahasiswa.store",
                "description": "id_prodi diperiksa melalui HTTP ke Service Prodi sebelum disimpan.",
                "summary": "Tambah mahasiswa",
                "tags": [
                    "Mahasiswa"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MahasiswaRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "201": {
                        "description": "Mahasiswa berhasil dibuat.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MahasiswaResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Service Prodi tidak tersedia atau respons tidak valid. Mahasiswa belum disimpan.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/mahasiswa/{mahasiswa}": {
            "get": {
                "operationId": "mahasiswa.show",
                "summary": "Detail mahasiswa",
                "tags": [
                    "Mahasiswa"
                ],
                "parameters": [
                    {
                        "name": "mahasiswa",
                        "in": "path",
                        "required": true,
                        "description": "The mahasiswa ID",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`MahasiswaResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MahasiswaResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            },
            "put": {
                "operationId": "mahasiswa.update",
                "summary": "Perbarui mahasiswa. NIM tetap unik; prodi diperiksa ulang melalui API",
                "tags": [
                    "Mahasiswa"
                ],
                "parameters": [
                    {
                        "name": "mahasiswa",
                        "in": "path",
                        "required": true,
                        "description": "The mahasiswa ID",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MahasiswaRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`MahasiswaResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MahasiswaResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "503": {
                        "description": "Service Prodi tidak tersedia atau respons tidak valid. Mahasiswa belum diperbarui.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "operationId": "mahasiswa.destroy",
                "summary": "Hapus mahasiswa. Tetap dapat digunakan saat Service Prodi tidak tersedia",
                "tags": [
                    "Mahasiswa"
                ],
                "parameters": [
                    {
                        "name": "mahasiswa",
                        "in": "path",
                        "required": true,
                        "description": "The mahasiswa ID",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "Mahasiswa berhasil dihapus."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "MahasiswaRequest": {
                "type": "object",
                "properties": {
                    "id_prodi": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "nama": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "nim": {
                        "type": "string",
                        "maxLength": 30
                    }
                },
                "required": [
                    "id_prodi",
                    "nama",
                    "nim"
                ],
                "title": "MahasiswaRequest"
            },
            "MahasiswaResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "id_prodi": {
                        "type": "integer"
                    },
                    "nama": {
                        "type": "string"
                    },
                    "nim": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "id_prodi",
                    "nama",
                    "nim"
                ],
                "title": "MahasiswaResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "ModelNotFoundException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}